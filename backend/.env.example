# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# ---- Database ------------------------------------------------------------
# Name of the AWS Secrets Manager secret holding the DB login (JSON with
# "username" and "password"; optional "host", "port", "dbname").
# Leave it empty to use DB_USER / DB_PASSWORD below (local development).
DB_Secret_name=

# Used when the secret doesn't supply them, and always for DB_NAME.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wms_db
DB_USER=
DB_PASSWORD=

# SSL for the migration runner. true for AWS RDS, false for local MySQL.
# DB_SSL_CA is optional: path to a PEM CA file; if empty, the bundled AWS RDS
# CA list is used.
DB_SSL=false
DB_SSL_CA=

# ---- Auth ----------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- AWS (S3 documents + Secrets Manager) -------------------------------------
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- SAML SSO ------------------------------------------------------------
# Base URL this API is reachable at (builds the SP entityID / ACS / metadata URLs).
APP_BASE_URL=http://localhost:5000
# Where the browser returns after the SAML login completes.
FRONTEND_BASE_URL=http://localhost:5173
# Encrypts secrets at rest (the SAML SP private key). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=
